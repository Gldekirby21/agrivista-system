# ==============================================================================
# OMAG Polomolok Agricultural Resource Distribution and Production Analytics System
# Environment Configuration Template
# ==============================================================================

# PostgreSQL via Prisma (Local or Supabase)
# For Supabase: DATABASE_URL is the Transaction Pooler (port 6543), DIRECT_URL is Session/Direct (port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&connect_timeout=20&pool_timeout=20"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Session & JWT Secret
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Python ML Microservice URL (FastAPI)
ML_SERVICE_URL="http://localhost:8000"
